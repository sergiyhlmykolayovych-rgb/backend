# Скопіюйте цей файл у .env і підставте власні значення.
# Сам .env у git не потрапляє.

# --- База даних ---
# PostgreSQL на Neon, як в ERP. Окрема база цього сайту: з базою ERP вона не повʼязана.
DATABASE_URL=

# --- JWT ---
# Два різні випадкові рядки, щонайменше 32 символи кожен.
# Згенерувати: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Сервер ---
PORT=3002
NODE_ENV=development
# Адреса публічного сайту й адмінки: дозволені origin для CORS. Кілька адрес — через кому.
SITE_URL=http://localhost:3000
ADMIN_URL=http://localhost:3003

# --- Власник сайту ---
# Потрібні лише для `pnpm prisma db seed`: сід створює власника, якщо в базі ще немає користувачів.
# Значення задавайте в середовищі на момент запуску сіда, у репозиторій їх не коммітьте.
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_FIRST_NAME=
OWNER_LAST_NAME=

# --- Захист форм ---
# Секретний ключ Cloudflare Turnstile. Без нього перевірка «я не робот» пропускається.
TURNSTILE_SECRET_KEY=

# --- Файли ---
# Cloudflare R2 (сумісне з S3): фото проєктів. Окремий bucket цього сайту.
# Адресу задайте цілком (R2_ENDPOINT) або ідентифікатором акаунта.
R2_ENDPOINT=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Без R2 файли пишуться на диск у цю папку (локальна розробка й тести).
UPLOADS_DIR=

# --- Тести ---
# Необовʼязково. За замовчуванням e2e-тести беруть DATABASE_URL і додають до назви бази «_test».
# TEST_DATABASE_URL=

# --- Telegram-бот для продажу проєктів ---
# Токен і імʼя бота видає @BotFather. Без них бот вимкнений.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Оплата: токен провайдера з @BotFather → Payments (для Portmone спершу тестовий).
# Без нього кнопка «Купити» відповідає, що оплата налаштовується.
TELEGRAM_PAYMENT_PROVIDER_TOKEN=
# Валюта рахунку; за замовчуванням UAH.
TELEGRAM_PAYMENT_CURRENCY=
# На сервері бот отримує повідомлення через webhook. Адреса береться з RAILWAY_PUBLIC_DOMAIN,
# на іншому хостингу задайте повністю: https://<сервер>/api/v1/telegram/webhook
TELEGRAM_WEBHOOK_URL=
# Лише для розробки: true вмикає отримання повідомлень без публічної адреси (опитування).
# Увага: це вимикає webhook бота, тому не вмикайте на токені бота, що вже працює на сервері.
TELEGRAM_POLLING=
